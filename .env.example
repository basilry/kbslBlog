# Keep false until the migration and OAuth providers are configured.
COMMUNITY_ENABLED=false
COMMUNITY_AUTH_PROVIDERS=google,kakao
# Local: http://localhost:3000. Production: https://www.basilry.kim
COMMUNITY_SITE_URL=http://localhost:3000

# Supabase project URL and API keys. All variables below stay on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key; never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Generate once: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable between deployments to preserve browser like identities.
COMMUNITY_COOKIE_SECRET=
